local alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local lookup = {}
for index = 1, #alphabet do
    lookup[alphabet:byte(index)] = index - 1
end
local decoded = {}
for index = 1, #encoded, 4 do
    local first = encoded:byte(index)
    local second = encoded:byte(index + 1)
    local third = encoded:byte(index + 2)
    local fourth = encoded:byte(index + 3)
    local padding = third == 61 and 2 or fourth == 61 and 1 or 0
    local value = bit32.bor(
        bit32.lshift(lookup[first], 18),
        bit32.lshift(lookup[second], 12),
        bit32.lshift(lookup[third] or 0, 6),
        lookup[fourth] or 0
    )
    decoded[#decoded + 1] = string.char(bit32.bxor(bit32.band(bit32.rshift(value, 16), 255), 173))
    if padding < 2 then
        decoded[#decoded + 1] = string.char(bit32.bxor(bit32.band(bit32.rshift(value, 8), 255), 173))
    end
    if padding < 1 then
        decoded[#decoded + 1] = string.char(bit32.bxor(bit32.band(value, 255), 173))
    end
end
local chunk, failure = loadstring(table.concat(decoded))
if not chunk then
    error(failure)
end
return chunk()
